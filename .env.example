# ==============================================================================
# DISAMBIGUATOR TEST RUNNER CONFIGURATION
# ==============================================================================

# Select one provider block: gemini | openai | ollama | anthropic | groq |
# deepseek | openrouter | vllm. Auto-detection applies only when PROVIDER is blank.
# TEST_MODEL and JUDGE_MODEL are global to the selected provider. When changing
# PROVIDER, change both model values in the same edit.

# --- Active example: Google Gemini ---
PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
TEST_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash

# --- OpenAI ---
# PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
# TEST_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini

# --- Local Ollama ---
# PROVIDER=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# TEST_MODEL=llama3.2
# JUDGE_MODEL=llama3.2

# --- Other OpenAI-compatible providers ---
# PROVIDER=openrouter  # or groq | deepseek | vllm
# OPENAI_API_KEY=your_provider_key_here
# OPENAI_BASE_URL=https://provider.example/v1
# TEST_MODEL=provider-specific-model
# JUDGE_MODEL=provider-specific-model

# --- Anthropic ---
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# TEST_MODEL=claude-3-5-sonnet-latest
# JUDGE_MODEL=claude-3-5-sonnet-latest
