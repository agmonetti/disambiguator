# ==============================================================================
# DISAMBIGUATOR TEST RUNNER CONFIGURATION
# ==============================================================================

# Provider selection: gemini | openai | ollama | anthropic (auto-detected if blank)
PROVIDER=gemini

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
TEST_MODEL=gemini-3.5-flash
JUDGE_MODEL=gemini-3.5-flash

# --- OpenAI / Ollama / Local LLMs / DeepSeek / Groq (OpenAI-compatible) ---
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1       # or http://localhost:11434/v1 for Ollama
# TEST_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o

# --- Anthropic Configuration ---
# ANTHROPIC_API_KEY=your_anthropic_key_here
# TEST_MODEL=claude-3-5-sonnet-latest
# JUDGE_MODEL=claude-3-5-sonnet-latest
